universe = vanilla
container_image = file:///staging/y/yzhong239/gradformer/nanochat-uv-v4.sif
executable = worker.sh
environment = "PUSHT_PHASE=recovery PUSHT_TRAIN_CONFIG=configs/pusht/robojepa22m_prefix_mse_finetune.yaml"
request_cpus = 4
request_memory = 32GB
request_disk = 100GB
request_gpus = 1
require_gpus = (GlobalMemoryMb >= 79000) && regexp("H200", DeviceName) && !regexp("MIG", DeviceName)
rank = regexp("H100|H200", GPUs_DeviceName)
requirements = (HasCHTCStaging == true)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
checkpoint_exit_code = 85
transfer_checkpoint_files = results.tar,checkpoints.tar
transfer_input_files = source.tar,goals.tar,robojepa-source.tar,vjepa-source.tar,osdf:///chtc/staging/y/yzhong239/nanowm-research/pusht-runtime-v1.tar,osdf:///chtc/staging/y/yzhong239/nanowm-research/pusht-assets-v1.tar,osdf:///chtc/staging/y/yzhong239/nanowm-research/robojepa-22m-v1.tar
transfer_output_files = results.tar,checkpoints.tar
output = logs/job.$(Cluster).out
error = logs/job.$(Cluster).err
log = logs/job.$(Cluster).log
stream_output = True
stream_error = True
hold = True
on_exit_hold = (ExitBySignal == true) || ((ExitCode != 0) && (ExitCode != 85))
+InteractiveJob = true
+JobBatchName = "nanowm-pusht-mse-3k-recovery"
+GPUJobLength = "short"
+MaxRuntime = 129600
queue 1
